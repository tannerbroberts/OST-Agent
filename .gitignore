node_modules/
# dist/* (not "dist/") is deliberate: git cannot re-include a file whose
# parent directory is excluded wholesale, so a plain "dist/" would make the
# negation below a no-op and silently break the ability to commit the bundle.
dist/*
!dist/ost-agent.mjs
# The capability manifest ships beside the artefact it describes, because an
# operator auditing what they are about to run has the plugin directory and
# nothing else. It is generated by `npm run manifest` (chained onto `bundle`).
!dist/capability-manifest.json
.env
.env.*
*.log
.DS_Store
.worktrees/

# SDD scratch (ledger, briefs, review packages)
.superpowers/

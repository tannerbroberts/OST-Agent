{
  "name": "ost-agent",
  "version": "0.7.0",
  "description": "Autonomous, append-only agent that maintains a Teresa Torres Opportunity Solution Tree as Obsidian-graph Markdown. Runs unmonitored; incapable of destructive action by construction.",
  "type": "module",
  "license": "MIT",
  "author": "Tanner Roberts",
  "homepage": "https://github.com/tannerbroberts/OST-Agent#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tannerbroberts/OST-Agent.git"
  },
  "bugs": {
    "url": "https://github.com/tannerbroberts/OST-Agent/issues"
  },
  "keywords": [
    "opportunity-solution-tree",
    "product-discovery",
    "teresa-torres",
    "continuous-discovery",
    "obsidian",
    "mcp",
    "claude-code",
    "append-only"
  ],
  "bin": {
    "ost-agent": "dist/cli/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli/index.ts",
    "gen:skill": "tsx scripts/gen-skill.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "tsx src/eval/run.ts",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build && npm run test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.70.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "commander": "^12.1.0",
    "croner": "^9.0.0",
    "gray-matter": "^4.0.3",
    "simple-git": "^3.27.0",
    "yaml": "^2.6.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}

{
  "name": "ost-agent",
  "version": "0.23.0",
  "private": true,
  "description": "Autonomous, append-only agent that maintains a Teresa Torres Opportunity Solution Tree as Obsidian-graph Markdown. Runs unmonitored; incapable of destructive action by construction.",
  "type": "module",
  "license": "MIT",
  "author": "Tanner Roberts",
  "homepage": "https://github.com/tannerbroberts/OST-Agent#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tannerbroberts/OST-Agent.git"
  },
  "bugs": {
    "url": "https://github.com/tannerbroberts/OST-Agent/issues"
  },
  "keywords": [
    "opportunity-solution-tree",
    "product-discovery",
    "teresa-torres",
    "continuous-discovery",
    "obsidian",
    "mcp",
    "claude-code",
    "append-only"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "bundle": "esbuild src/cli/index.ts --bundle --platform=node --target=node20 --format=esm --banner:js=\"import{createRequire as __ost_createRequire}from'node:module';const require=__ost_createRequire(import.meta.url);\" --outfile=dist/ost-agent.mjs",
    "dev": "tsx src/cli/index.ts",
    "gen:skill": "tsx scripts/gen-skill.ts",
    "harness": "tsx scripts/harness.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "commander": "^12.1.0",
    "gray-matter": "^4.0.3",
    "simple-git": "^3.27.0",
    "yaml": "^2.6.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
